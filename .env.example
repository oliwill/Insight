# trader-obsidian 环境配置
# 1. 复制为 .env：cp .env.example .env
# 2. 将路径改成你的 Obsidian vault / Trader workspace 真实路径
# 3. API key 留空时，系统会使用免费数据源或跳过对应增强模块

# ── 长桥 API（可选，不填则自动 fallback 到 Yahoo Finance）──
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=

# ── 搜索 API（可选；不填则使用 Yahoo Finance News + DuckDuckGo HTML）──
SERPAPI_KEY=
NEWSAPI_KEY=

# ── Obsidian Trader workspace ──
# 建议指向 Trader 工作区根目录；Analysis、Materials、Charts 会位于此目录下。
# 示例：/Users/al/.../Lzw/4_Trader 或 C:/Users/Lzw/.../Lzw/4_Trader
WIKI_BASE_DIR=/path/to/your/obsidian/vault/4_Trader
WIKI_SUBDIR=Analysis
MATERIALS_SUBDIR=Materials

# ── Obsidian 全局目录（可放在 vault 根目录或 Trader workspace 内）──
OBSIDIAN_INBOX_DIR=/path/to/your/obsidian/vault/Inbox
OBSIDIAN_TASKS_DIR=/path/to/your/obsidian/vault/Tasks
OBSIDIAN_DASHBOARD_PATH=/path/to/your/obsidian/vault/Dashboard.md

# ── Inbox watcher / Podwise 输入目录（可选）──
OBSIDIAN_CLIPPINGS_DIR=/path/to/your/obsidian/vault/Clippings
OBSIDIAN_RAW_DIR=/path/to/your/obsidian/vault/Raw

# ── Telegram bot / Telegram 通知（可选）──
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# ── 飞书 / 企业微信机器人 webhook（可选，填一个即启用；飞书优先）──
# 飞书：群 → 设置 → 群机器人 → 自定义机器人 → 获取 webhook
FEISHU_WEBHOOK_URL=
# 企业微信：群 → 群机器人 → 新创建一个 → 获取 webhook
WECOM_WEBHOOK_URL=

# ── Podwise 同步（可选）──
PODWISE_CLI_PATH=podwise
PODWISE_SYNC_DAYS=7
PODWISE_OUTPUT_DIR=

# ── 分析超时保护 ──
ANALYSIS_TIMEOUT=30

# ── Web 平台（线上化）──
# SQLite 数据库与用户 vault 目录（Docker 部署时挂载 ./data 卷）
WEB_DB_PATH=data/web.db
USERS_DATA_DIR=data/users
WEB_PORT=8000
# 登录会话有效期（天）；每用户每日分析次数配额
SESSION_TTL_DAYS=7
ANALYSIS_DAILY_QUOTA=10
# 注册邀请码（留空 = 开放注册；公网部署建议设置）
INVITE_CODE=

# ── LLM 报告增强（可选；留空则报告为纯确定性文本）──
# 兼容 OpenAI Chat Completions 协议的任意端点（DeepSeek / OpenAI / 中转）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ── Python scheduler.py 守护进程配置（macOS/Linux）──
SCHEDULE_SCAN_INBOX=*/30 * * * *
SCHEDULE_REVIEW=0 9 * * *
SCHEDULE_DASHBOARD=0 8 * * *
SCHEDULE_BRIEF=0 9 * * *
SCHEDULE_NOTIFY=true

# ── 每日简报（Daily Brief）──
BRIEF_LOOKBACK_DAYS=7
BRIEF_TOP_N=3
BRIEF_MATERIALS_LIMIT=5

# ── 飞书远程指令机器人（自建应用，非 webhook）──
# 白名单：只允许此 open_id 触发本地分析（首次运行 bot 后发条消息给它，bot 会回复你的 open_id）
FEISHU_BOT_ALLOWED_OPEN_ID=
# 自建应用凭证（lark-cli auth login 已配置则可不填）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
